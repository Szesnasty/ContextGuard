# ContextGuard local stack — copy to .env and adjust if a port collides.
# Every host port the compose stack binds is listed here (ADR-003 / step 0.3).

# --- Postgres (application data + pgvector) ---
POSTGRES_USER=contextguard
POSTGRES_PASSWORD=contextguard
POSTGRES_DB=contextguard
POSTGRES_PORT=5432

# --- Redis (cache + RQ job queue) ---
REDIS_PORT=6379

# --- Ollama (local LLM + embeddings, fully offline) ---
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Langfuse (observability / tracing) ---
LANGFUSE_PORT=3001
LANGFUSE_NEXTAUTH_SECRET=local-dev-secret-change-me
LANGFUSE_SALT=local-dev-salt-change-me

# --- App (set later, phase 0.4+) ---
DATABASE_URL=postgresql://contextguard:contextguard@localhost:5432/contextguard
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434
