# ContextGuard local demo settings.
#
# Copy this file to `.env` if you want to customize local ports or runtime
# behavior. `make demo` also works without `.env`; these values are the defaults.
# Do not put production credentials in this example file.

# --- Postgres (application data + pgvector) ---
POSTGRES_USER=contextguard
POSTGRES_PASSWORD=contextguard
POSTGRES_DB=contextguard
POSTGRES_PORT=5432

# --- Redis (cache + RQ job queue) ---
REDIS_PORT=6379

# --- Ollama (local LLM + embeddings, fully offline) ---
# On Apple Silicon, run Ollama NATIVELY (brew install ollama) for Metal GPU
# acceleration and point OLLAMA_BASE_URL at 127.0.0.1 below. The Docker ollama
# service is CPU-only inside the Linux VM and is markedly slower.
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# --- Langfuse (observability / tracing) ---
LANGFUSE_PORT=3001
LANGFUSE_NEXTAUTH_SECRET=local-dev-secret-change-me
LANGFUSE_SALT=local-dev-salt-change-me

# --- API / dashboard ---
API_PORT=8000
WEB_PORT=5173
POLICY_PATH=data/policies/example.yaml
EVIDENCE_SINK=postgres
DATABASE_URL=postgresql://contextguard:contextguard@localhost:5432/contextguard
REDIS_URL=redis://localhost:6379/0
# 127.0.0.1 (not localhost) so the host API hits the native Metal Ollama, not the
# dual-stack Docker container that also binds :11434 over IPv6.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Production-only auth switch ---
# Leave JWT_SECRET unset for the local demo. Setting it disables the dev token
# minter and one-click model management endpoints.
# JWT_SECRET=replace-with-a-real-secret-outside-demo

# --- Optional cloud backends ---
# The demo is offline-first and does not need these.
# LLM=openai
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# EMBEDDINGS=openai
