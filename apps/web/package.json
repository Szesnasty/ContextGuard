{
  "name": "@contextguard/web",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-reports.mjs",
    "build": "vue-tsc -b && vite build",
