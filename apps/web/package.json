{
  "name": "@contextguard/web",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-reports.mjs",
    "build": "vue-tsc -b && vite build",
    "prebuild": "node scripts/copy-reports.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
