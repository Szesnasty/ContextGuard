    "copy:reports": "node scripts/copy-reports.mjs"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.101.0",
    "@tanstack/vue-table": "8.21.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "diff": "9.0.0",
    "dompurify": "3.4.8",
    "marked": "18.0.5",
    "monaco-editor": "0.55.1",
    "openapi-fetch": "0.17.0",
    "pinia": "3.0.4",
    "vue": "3.5.35",
    "vue-router": "5.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/diff": "8.0.0",
    "@types/node": "25.9.2",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/eslint-config-typescript": "14.8.0",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.4.1",
    "eslint-plugin-vue": "10.9.2",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "sass": "1.100.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8",
    "vue-tsc": "3.3.4"
