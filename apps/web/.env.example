# Absolute API origin for the typed client. Leave empty in local dev so the
# browser uses the same origin and Vite proxies /v1, /health and /metrics.
# Set to e.g. https://api.example.com for a deployed frontend.
VITE_API_BASE=

# Local-only proxy target used by Vite. `make demo` sets this automatically when
# it has to move the API to a non-default port.
VITE_API_PROXY=http://127.0.0.1:8000
