{
  "$defs": {
    "Chunk": {
      "additionalProperties": false,
      "description": "A retrieved unit of context. Enrichment fields stay empty until phase 3.",
      "properties": {
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Metadata",
          "type": "object"
        },
        "pii_spans": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Pii Spans",
          "type": "array"
        },
        "risk_signals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RiskSignal"
          },
          "title": "Risk Signals",
          "type": "array"
        },
        "secret_spans": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Secret Spans",
          "type": "array"
        },
        "tenant": {
          "title": "Tenant",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "doc_id",
        "tenant",
        "text",
        "classification"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "ChunkDecision": {
      "additionalProperties": false,
      "description": "The guard's verdict for one chunk, with auditable reasons.",
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "policies_triggered": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Policies Triggered",
          "type": "array"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "chunk_id",
        "outcome"
      ],
      "title": "ChunkDecision",
      "type": "object"
    },
    "Classification": {
      "description": "Sensitivity label attached to a chunk/document, lowest to highest.",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Classification",
      "type": "string"
    },
    "GuardedContext": {
      "additionalProperties": false,
      "description": "The result of ``guard()``: what survived, every decision, token deltas.",
      "properties": {
        "allowed_chunks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Chunk"
          },
          "title": "Allowed Chunks",
          "type": "array"
        },
        "decisions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ChunkDecision"
          },
          "title": "Decisions",
          "type": "array"
        },
        "tokens_after": {
          "default": 0,
          "title": "Tokens After",
          "type": "integer"
        },
        "tokens_before": {
          "default": 0,
          "title": "Tokens Before",
          "type": "integer"
        }
      },
      "title": "GuardedContext",
      "type": "object"
    },
    "Outcome": {
      "description": "What the guard decided to do with a single chunk.",
      "enum": [
        "allowed",
        "blocked",
        "redacted"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "RetrievedChunk": {
      "additionalProperties": false,
      "description": "One retrieval hit returned to the caller: identity, text, fused score.",
      "properties": {
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Metadata",
          "type": "object"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "tenant": {
          "title": "Tenant",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "doc_id",
        "tenant",
        "classification",
        "text",
        "score"
      ],
      "title": "RetrievedChunk",
      "type": "object"
    },
    "RiskSignal": {
      "additionalProperties": false,
      "description": "An adversarial signal detected in a chunk, with a confidence weight.",
      "properties": {
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/RiskType"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "type",
        "weight",
        "evidence"
      ],
      "title": "RiskSignal",
      "type": "object"
    },
    "RiskType": {
      "description": "Adversarial signal categories a chunk may carry (filled from phase 3).",
      "enum": [
        "injection",
        "role_override",
        "exfiltration",
        "hidden_text",
        "tool_instruction"
      ],
      "title": "RiskType",
      "type": "string"
    },
    "Span": {
      "additionalProperties": false,
      "description": "A half-open ``[start, end)`` character range of sensitive text.",
      "properties": {
        "end": {
          "title": "End",
          "type": "integer"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "subtype": {
          "title": "Subtype",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SpanType"
        }
      },
      "required": [
        "type",
        "subtype",
        "start",
        "end"
      ],
      "title": "Span",
      "type": "object"
    },
    "SpanType": {
      "description": "Kind of sensitive span detected within a chunk's text.",
      "enum": [
        "pii",
        "secret"
      ],
      "title": "SpanType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The grounded answer plus the retrieval hits and the guard's verdict.",
  "properties": {
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "guarded_context": {
      "$ref": "#/$defs/GuardedContext"
    },
    "retrieved_chunks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RetrievedChunk"
      },
      "title": "Retrieved Chunks",
      "type": "array"
    }
  },
  "required": [
    "answer",
    "guarded_context"
  ],
  "title": "QueryResponse",
  "type": "object"
}
