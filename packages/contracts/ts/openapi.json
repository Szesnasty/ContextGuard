{
  "components": {
    "schemas": {
      "Chunk": {
        "additionalProperties": false,
        "description": "A retrieved unit of context. Enrichment fields stay empty until phase 3.",
        "properties": {
          "classification": {
            "$ref": "#/components/schemas/Classification"
          },
          "doc_id": {
            "title": "Doc Id",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "title": "Metadata",
            "type": "object"
          },
          "pii_spans": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Span"
            },
            "title": "Pii Spans",
            "type": "array"
          },
          "risk_signals": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/RiskSignal"
            },
            "title": "Risk Signals",
            "type": "array"
          },
          "secret_spans": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Span"
            },
            "title": "Secret Spans",
            "type": "array"
          },
          "tenant": {
            "title": "Tenant",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "doc_id",
          "tenant",
          "text",
          "classification"
        ],
        "title": "Chunk",
        "type": "object"
      },
      "ChunkDecision": {
        "additionalProperties": false,
        "description": "The guard's verdict for one chunk, with auditable reasons.",
        "properties": {
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "policies_triggered": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Policies Triggered",
            "type": "array"
          },
          "reasons": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          }
        },
        "required": [
          "chunk_id",
          "outcome"
        ],
        "title": "ChunkDecision",
        "type": "object"
      },
      "Classification": {
        "description": "Sensitivity label attached to a chunk/document, lowest to highest.",
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted"
        ],
        "title": "Classification",
        "type": "string"
      },
      "DevIdentity": {
        "description": "A demo identity the dev minter can issue a token for.",
        "properties": {
          "purpose": {
            "title": "Purpose",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "sub": {
            "title": "Sub",
            "type": "string"
          },
          "tenant": {
            "title": "Tenant",
            "type": "string"
          }
        },
        "required": [
          "sub",
          "tenant",
          "role",
          "purpose"
        ],
        "title": "DevIdentity",
        "type": "object"
      },
      "DevTokenRequest": {
        "description": "Which demo identity to mint a token for.",
        "properties": {
          "sub": {
            "description": "Demo identity 'sub' from data/users.yaml.",
            "minLength": 1,
            "title": "Sub",
            "type": "string"
          }
        },
        "required": [
          "sub"
        ],
        "title": "DevTokenRequest",
        "type": "object"
      },
      "DevTokenResponse": {
        "description": "A freshly minted demo token and the identity it carries.",
        "properties": {
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "purpose": {
            "title": "Purpose",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "sub": {
            "title": "Sub",
            "type": "string"
          },
          "tenant": {
            "title": "Tenant",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "sub",
          "tenant",
          "role",
          "purpose",
          "expires_in"
        ],
        "title": "DevTokenResponse",
        "type": "object"
      },
      "GuardRequest": {
        "additionalProperties": false,
        "description": "A scan-only request: the query plus the candidate chunks to adjudicate.\n\nIdentity is NOT carried here - it is derived from the verified Bearer token\nat the HTTP boundary (ADR-015). The caller supplies the chunks to guard, so\nthe scan runs without retrieval or a model call (Milestone B3.3).",
        "properties": {
          "candidate_chunks": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Chunk"
            },
            "title": "Candidate Chunks",
            "type": "array"
          },
          "query": {
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "GuardRequest",
        "type": "object"
      },
      "GuardedContext": {
        "additionalProperties": false,
        "description": "The result of ``guard()``: what survived, every decision, token deltas.",
        "properties": {
          "allowed_chunks": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Chunk"
            },
            "title": "Allowed Chunks",
            "type": "array"
          },
          "decisions": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ChunkDecision"
            },
            "title": "Decisions",
            "type": "array"
          },
          "tokens_after": {
            "default": 0,
            "title": "Tokens After",
            "type": "integer"
          },
          "tokens_before": {
            "default": 0,
            "title": "Tokens Before",
            "type": "integer"
          }
        },
        "title": "GuardedContext",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Outcome": {
        "description": "What the guard decided to do with a single chunk.",
        "enum": [
          "allowed",
          "blocked",
          "redacted"
        ],
        "title": "Outcome",
        "type": "string"
      },
      "QueryRequest": {
        "additionalProperties": false,
        "description": "A RAG query: what is asked and how many chunks to retrieve.\n\nIdentity is NOT carried here - it is derived from the verified Bearer token\nat the HTTP boundary (ADR-015), never asserted by the client body.",
        "properties": {
          "k": {
            "default": 5,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "K",
            "type": "integer"
          },
          "query": {
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "QueryResponse": {
        "additionalProperties": false,
        "description": "The grounded answer plus the retrieval hits and the guard's verdict.",
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "guarded_context": {
            "$ref": "#/components/schemas/GuardedContext"
          },
          "retrieved_chunks": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/RetrievedChunk"
            },
            "title": "Retrieved Chunks",
            "type": "array"
          }
        },
        "required": [
          "answer",
          "guarded_context"
        ],
        "title": "QueryResponse",
        "type": "object"
      },
      "RetrievedChunk": {
        "additionalProperties": false,
        "description": "One retrieval hit returned to the caller: identity, text, fused score.",
        "properties": {
          "classification": {
            "$ref": "#/components/schemas/Classification"
          },
          "doc_id": {
            "title": "Doc Id",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "title": "Metadata",
            "type": "object"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "tenant": {
            "title": "Tenant",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "doc_id",
          "tenant",
          "classification",
          "text",
          "score"
        ],
        "title": "RetrievedChunk",
        "type": "object"
      },
      "RiskSignal": {
        "additionalProperties": false,
        "description": "An adversarial signal detected in a chunk, with a confidence weight.",
        "properties": {
          "evidence": {
            "title": "Evidence",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/RiskType"
          },
          "weight": {
            "title": "Weight",
            "type": "number"
          }
        },
        "required": [
          "type",
          "weight",
          "evidence"
        ],
        "title": "RiskSignal",
        "type": "object"
      },
      "RiskType": {
        "description": "Adversarial signal categories a chunk may carry (filled from phase 3).",
        "enum": [
          "injection",
          "role_override",
          "exfiltration",
          "hidden_text",
          "tool_instruction"
        ],
        "title": "RiskType",
        "type": "string"
      },
      "Span": {
        "additionalProperties": false,
        "description": "A half-open ``[start, end)`` character range of sensitive text.",
        "properties": {
          "end": {
            "title": "End",
            "type": "integer"
          },
          "start": {
            "title": "Start",
            "type": "integer"
          },
          "subtype": {
            "title": "Subtype",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/SpanType"
          }
        },
        "required": [
          "type",
          "subtype",
          "start",
          "end"
        ],
        "title": "Span",
        "type": "object"
      },
      "SpanType": {
        "description": "Kind of sensitive span detected within a chunk's text.",
        "enum": [
          "pii",
          "secret"
        ],
        "title": "SpanType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Signed identity token (ADR-015 stub).",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "summary": "Policy-aware context firewall for production RAG.",
    "title": "ContextGuard",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics",
        "tags": [
          "meta"
        ]
      }
    },
    "/v1/dev/identities": {
      "get": {
        "description": "List the demo identities the dev minter can issue tokens for.",
        "operationId": "list_identities_v1_dev_identities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DevIdentity"
                  },
                  "title": "Response List Identities V1 Dev Identities Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Identities",
        "tags": [
          "dev"
        ]
      }
    },
    "/v1/dev/token": {
      "post": {
        "description": "Mint a signed token for a demo identity (dev only).",
        "operationId": "mint_token_v1_dev_token_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mint Token",
        "tags": [
          "dev"
        ]
      }
    },
    "/v1/guard": {
      "post": {
        "description": "Adjudicate caller-supplied chunks against the policy - no model call.",
        "operationId": "guard_scan_v1_guard_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuardRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardedContext"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Guard Scan",
        "tags": [
          "guard"
        ]
      }
    },
    "/v1/query": {
      "post": {
        "description": "Retrieve, guard, build a cited prompt, and return a grounded answer.",
        "operationId": "query_v1_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Query",
        "tags": [
          "query"
        ]
      }
    }
  }
}
